generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Album {
  id             Int        @id @default(autoincrement())
  title          String
  artist         String
  releaseYear    Int
  releaseMonth   Int
  genre          String
  coverUrl       String?
  description    String?
  createdAt      DateTime   @default(now())
  authorId       Int?
  author         User?      @relation(fields: [authorId], references: [id])
  favorites      Favorite[]
}

model User {
  id            Int        @id @default(autoincrement())
  name          String
  email         String     @unique
  passwordHash  String
  birthdate     DateTime
  favoriteGenre String
  createdAt     DateTime   @default(now())
  albums        Album[]
  favorites     Favorite[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  albumId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  album     Album    @relation(fields: [albumId], references: [id])

  @@unique([userId, albumId])
}
