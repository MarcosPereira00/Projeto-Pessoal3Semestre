// Modelo do banco. O Prisma le este arquivo e gera as tabelas (migrations)
// e o client usado nos controllers. Banco: SQLite (arquivo dev.db).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Album: o recurso principal. authorId aponta pra quem cadastrou (null nos que vieram do seed).
model Album {
  id             Int        @id @default(autoincrement())
  title          String
  artist         String
  releaseYear    Int
  releaseMonth   Int
  genre          String
  coverUrl       String?
  description    String?
  createdAt      DateTime   @default(now())
  authorId       Int?
  author         User?      @relation(fields: [authorId], references: [id])
  favorites      Favorite[]
}

// User: conta de quem usa o site. Guarda so o hash da senha, nunca a senha em si.
model User {
  id            Int        @id @default(autoincrement())
  name          String
  email         String     @unique
  passwordHash  String
  birthdate     DateTime
  favoriteGenre String
  createdAt     DateTime   @default(now())
  albums        Album[]
  favorites     Favorite[]
}

// Favorite: liga um usuario a um album. O unique impede favoritar o mesmo album duas vezes.
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  albumId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  album     Album    @relation(fields: [albumId], references: [id])

  @@unique([userId, albumId])
}
