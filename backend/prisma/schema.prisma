generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Album {
  id             Int      @id @default(autoincrement())
  title          String
  artist         String
  releaseYear    Int
  releaseMonth   Int
  genre          String
  coverUrl       String?
  description    String?
  createdAt      DateTime @default(now())
}
